# --- Application ---
APP_ENV=development
# Generate strong random: python -c "import secrets; print(secrets.token_hex(32))"
OPENOPS_API_KEY=
OPENOPS_SERVICE_USER_ID=service
# Token-gates /docs, /redoc, /openapi.json in production. Required when APP_ENV=production.
DOCS_TOKEN=

# --- Security / limits ---
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=10485760

# --- Database (Supabase local defaults shown) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
